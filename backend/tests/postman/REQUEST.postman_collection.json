            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \" Nguyễn Minh An \",\n  \"gradeLevel\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"ApiResponse\", () => pm.expect(pm.response.json().success).to.equal(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
